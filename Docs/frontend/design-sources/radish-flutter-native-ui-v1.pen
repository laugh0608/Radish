                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "这意味着 Flutter 不复制 WebOS。Compact 以底部导航和单列阅读为主；Expanded 使用原生 NavigationRail 与稳定的上下文区域，让阅读位置与操作入口保持可预测。",
                                  "lineHeight": 1.55,
                                  "fontFamily": "$font-body",
                                  "fontSize": 14,
                                  "fontWeight": "normal"
                                },
