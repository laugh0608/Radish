                      "fill": "$text-secondary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "没有宏大的计划，只是几盆薄荷、迷迭香和邻居们留下的小木牌。",
                      "lineHeight": 1.65,
                      "fontFamily": "$font-body",
                      "fontSize": 14,
