                {
                  "type": "text",
                  "id": "OwzIx",
                  "name": "Mobile / 引言",
                  "fill": "$text-primary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "上周五，楼道尽头那块一直堆着旧纸箱的公共阳台终于被清了出来。起因只是群里有人问了一句：这里能不能放几盆大家都可以摘的香草？没想到当晚就有十几个人报名。",
                  "lineHeight": 1.78,
                  "fontFamily": "$font-body",
                  "fontSize": 15,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "e2hciU",
                  "name": "Mobile / 小标题一",
                  "fill": "$text-primary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "从一张征集纸开始",
                  "lineHeight": 1.4,
                  "fontFamily": "$font-body",
                  "fontSize": 20,
                  "fontWeight": "700"
                },
