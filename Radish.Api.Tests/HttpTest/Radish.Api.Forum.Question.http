@Access_Token = 在这里粘贴通过 OIDC 获取的 access_token
@Gateway_HostAddress = https://localhost:5000

@ForumQuestion_PostId = 在这里填入问答帖的 postId
@ForumQuestion_PostPublicId = 在这里填入问答帖的 postPublicId
@ForumQuestion_NonQuestionPostPublicId = 在这里填入普通帖的 postPublicId
@ForumQuestion_AnswerPublicId = 在这里填入回答的 ans_ PublicId
@ForumQuestion_AnswerRevision = 1
@ForumQuestion_AcceptanceRevision = 0
@ForumQuestion_AnsweredKeyword = 论坛问答 MVP 验收帖

### 发布问答帖
POST {{Gateway_HostAddress}}/api/v1/Post/Publish
Content-Type: application/json
Authorization: Bearer {{Access_Token}}

{
  "title": "论坛问答 MVP 验收帖",
  "content": "用于串联论坛问答 MVP 验收：列表识别、详情展示、回答提交与提问者采纳。",
  "categoryId": 1,
  "tagNames": ["问答", "验收"],
  "isQuestion": true
}

### 获取问答帖列表（默认视图）
GET {{Gateway_HostAddress}}/api/v1/Post/GetList?postType=question&keyword={{ForumQuestion_AnsweredKeyword}}&pageIndex=1&pageSize=10
Accept: application/json
Authorization: Bearer {{Access_Token}}

### 获取问答帖列表（待解决优先）
GET {{Gateway_HostAddress}}/api/v1/Post/GetList?postType=question&sortBy=pending&pageIndex=1&pageSize=10
Accept: application/json
Authorization: Bearer {{Access_Token}}

### 获取问答帖列表（按回答数排序）
GET {{Gateway_HostAddress}}/api/v1/Post/GetList?postType=question&sortBy=answers&pageIndex=1&pageSize=10
Accept: application/json
Authorization: Bearer {{Access_Token}}

### 获取问答帖列表（仅待解决）
GET {{Gateway_HostAddress}}/api/v1/Post/GetList?postType=question&questionStatus=pending&pageIndex=1&pageSize=10
Accept: application/json
Authorization: Bearer {{Access_Token}}

### 获取问答帖列表（仅已解决）
GET {{Gateway_HostAddress}}/api/v1/Post/GetList?postType=question&questionStatus=solved&pageIndex=1&pageSize=10
Accept: application/json
Authorization: Bearer {{Access_Token}}

### 获取问答帖详情（默认回答排序）
GET {{Gateway_HostAddress}}/api/v1/Post/GetById/{{ForumQuestion_PostId}}
Accept: application/json
Authorization: Bearer {{Access_Token}}

### 获取问答帖详情（最新回答优先）
GET {{Gateway_HostAddress}}/api/v1/Post/GetById/{{ForumQuestion_PostId}}?answerSort=latest
Accept: application/json
Authorization: Bearer {{Access_Token}}

### 获取问题历史
GET {{Gateway_HostAddress}}/api/v1/Post/GetEditHistory?postId={{ForumQuestion_PostId}}&pageIndex=1&pageSize=10
Accept: application/json
Authorization: Bearer {{Access_Token}}

### 提交回答
POST {{Gateway_HostAddress}}/api/v1/Question/Answer
Content-Type: application/json
Authorization: Bearer {{Access_Token}}

{
  "postIdentifier": "{{ForumQuestion_PostPublicId}}",
  "content": "先检查配置、连接串和日志输出，再定位具体异常。",
  "clientSubmissionId": "question-answer-create-{{$guid}}"
}

### 服务端分页查询回答
GET {{Gateway_HostAddress}}/api/v1/Question/Page?postIdentifier={{ForumQuestion_PostPublicId}}&pageIndex=1&pageSize=20&sort=default
Accept: application/json
Authorization: Bearer {{Access_Token}}

### 作者编辑回答（ContentRevision CAS）
POST {{Gateway_HostAddress}}/api/v1/Question/Edit
Content-Type: application/json
Authorization: Bearer {{Access_Token}}

{
  "answerPublicId": "{{ForumQuestion_AnswerPublicId}}",
  "content": "先检查配置和连接串，再结合结构化日志定位具体异常。",
  "expectedContentRevision": {{ForumQuestion_AnswerRevision}},
  "clientSubmissionId": "question-answer-edit-{{$guid}}"
}

### 作者查询回答版本
GET {{Gateway_HostAddress}}/api/v1/Question/Revisions?answerPublicId={{ForumQuestion_AnswerPublicId}}
Accept: application/json
Authorization: Bearer {{Access_Token}}

### 作者查询回答版本详情
GET {{Gateway_HostAddress}}/api/v1/Question/Revision?answerPublicId={{ForumQuestion_AnswerPublicId}}&revisionNumber=1
Accept: application/json
Authorization: Bearer {{Access_Token}}

### 作者恢复回答版本（生成新 Revision）
POST {{Gateway_HostAddress}}/api/v1/Question/Restore
Content-Type: application/json
Authorization: Bearer {{Access_Token}}

{
  "answerPublicId": "{{ForumQuestion_AnswerPublicId}}",
  "revisionNumber": 1,
  "expectedContentRevision": {{ForumQuestion_AnswerRevision}},
  "clientSubmissionId": "question-answer-restore-{{$guid}}"
}

### 提问者采纳回答
POST {{Gateway_HostAddress}}/api/v1/Question/Accept
Content-Type: application/json
Authorization: Bearer {{Access_Token}}

{
  "postIdentifier": "{{ForumQuestion_PostPublicId}}",
  "answerPublicId": "{{ForumQuestion_AnswerPublicId}}",
  "expectedAcceptanceRevision": {{ForumQuestion_AcceptanceRevision}},
  "clientSubmissionId": "question-answer-accept-{{$guid}}"
}

### 提问者撤销采纳
POST {{Gateway_HostAddress}}/api/v1/Question/Revoke
Content-Type: application/json
Authorization: Bearer {{Access_Token}}

{
  "postIdentifier": "{{ForumQuestion_PostPublicId}}",
  "expectedAcceptanceRevision": {{ForumQuestion_AcceptanceRevision}},
  "clientSubmissionId": "question-answer-revoke-{{$guid}}"
}

### 作者删除未采纳回答
POST {{Gateway_HostAddress}}/api/v1/Question/Delete
Content-Type: application/json
Authorization: Bearer {{Access_Token}}

{
  "answerPublicId": "{{ForumQuestion_AnswerPublicId}}",
  "expectedContentRevision": {{ForumQuestion_AnswerRevision}},
  "clientSubmissionId": "question-answer-delete-{{$guid}}"
}

### 普通帖提交回答（预期失败）
POST {{Gateway_HostAddress}}/api/v1/Question/Answer
Content-Type: application/json
Authorization: Bearer {{Access_Token}}

{
  "postIdentifier": "{{ForumQuestion_NonQuestionPostPublicId}}",
  "content": "普通帖不应允许走问答回答接口。"
}
