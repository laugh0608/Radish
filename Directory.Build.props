<Project>
  <PropertyGroup>
    <DisableImplicitNuGetFallbackFolder>true</DisableImplicitNuGetFallbackFolder>
    <RestoreConfigFile Condition="'$(RestoreConfigFile)' == '' and Exists('$(MSBuildThisFileDirectory)NuGet.Config')">$(MSBuildThisFileDirectory)NuGet.Config</RestoreConfigFile>

    <!-- 项目版本号 (日历版本: vYY.M.RELEASE) -->
    <Version>26.8.2</Version>
    <AssemblyVersion>26.8.2</AssemblyVersion>
    <FileVersion>26.8.2</FileVersion>

    <!-- Rust native outputs (built by cargo) -->
    <RadishRustTargetDir>$(MSBuildThisFileDirectory)Lib/radish.lib/target</RadishRustTargetDir>
  </PropertyGroup>

</Project>
