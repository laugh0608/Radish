+#ifndef FLB_SYSTEM_WINDOWS
+static int block_radish_file(struct flb_file_conf *ctx, const struct stat *file,
+                             int possibly_written)
+{
+    ctx->radish_blocked = FLB_TRUE;
+    ctx->radish_blocked_device = file->st_dev;
+    ctx->radish_blocked_inode = file->st_ino;
+#ifdef FLB_HAVE_METRICS
+    cmt_gauge_set(ctx->radish_file_blocked, cfl_time_now(), 1, 1,
+                  (char *[]) {(char *) flb_output_name(ctx->ins)});
+    if (possibly_written) {
+        cmt_counter_inc(ctx->radish_file_unknown, cfl_time_now(), 1,
+                        (char *[]) {(char *) flb_output_name(ctx->ins)});
+    }
+#endif
+    flb_plg_error(ctx->ins, "JSONL destination blocked: file state unverified");
+
+    /* The ambiguous batch must not be replayed over a potentially written prefix. */
+    return possibly_written ? FLB_ERROR : FLB_RETRY;
+}
+
+static int flush_radish_file(struct flb_file_conf *ctx, const char *path,
+                            struct flb_event_chunk *event_chunk, int escape_unicode)
+{
+    struct flb_log_event_decoder decoder;
+    struct flb_log_event event;
+    struct file_rotate_entry *rotation;
+    struct stat file;
+    enum radish_jsonl_result outcome;
+    const char *stage;
+    char *json;
+    size_t size;
+    int fd;
+    int result = FLB_RETRY;
+    int error = 0;
+    int status;
+
+    if (file_rotate_lock(ctx->rotation, path, &rotation) != 0) {
+        return FLB_RETRY;
+    }
+
+    fd = radish_jsonl_open(path, &file);
+    if (fd < 0) {
+        error = errno;
+        flb_plg_error(ctx->ins, "JSONL open failed (errno=%d)", error);
+        if (!ctx->radish_blocked &&
+            (error == EACCES || error == EPERM || error == EROFS || error == ELOOP)) {
+            result = FLB_ERROR;
+        }
+        goto release;
+    }
+
+    if (ctx->radish_blocked && file.st_dev == ctx->radish_blocked_device &&
+        file.st_ino == ctx->radish_blocked_inode) {
+        close(fd);
+        goto release;
+    }
+
+    if (radish_jsonl_repair_tail(fd, &file) != 0) {
+        close(fd);
+        result = block_radish_file(ctx, &file, FLB_FALSE);
+        goto release;
+    }
+
+    if (ctx->radish_blocked) {
+        ctx->radish_blocked = FLB_FALSE;
+#ifdef FLB_HAVE_METRICS
+        cmt_gauge_set(ctx->radish_file_blocked, cfl_time_now(), 0, 1,
+                      (char *[]) {(char *) flb_output_name(ctx->ins)});
+#endif
+    }
+
+    file_rotate_update(rotation, NULL);
+    status = file_rotate_if_needed(rotation);
+    if (status < 0) {
+        if (close(fd) != 0) {
+            result = block_radish_file(ctx, &file, FLB_FALSE);
+        }
+        goto release;
+    }
+    if (status > 0) {
+        /* The checked inode is now sealed. Use a fresh active file. */
+        if (close(fd) != 0) {
+            result = block_radish_file(ctx, &file, FLB_FALSE);
+            goto release;
+        }
+        fd = radish_jsonl_open(path, &file);
+        if (fd < 0) {
+            flb_plg_error(ctx->ins, "JSONL open after rotation failed (errno=%d)", errno);
+            goto release;
+        }
+    }
+
+    stage = "decode";
+    status = flb_log_event_decoder_init(&decoder, (char *) event_chunk->data,
+                                         event_chunk->size);
+    if (status != FLB_EVENT_DECODER_SUCCESS) {
+        error = EINVAL;
+        result = FLB_ERROR;
+        goto finish;
+    }
+
+    while (flb_log_event_decoder_next(&decoder, &event) == FLB_EVENT_DECODER_SUCCESS) {
+        json = flb_msgpack_to_json_str(256, event.body, escape_unicode);
+        if (json == NULL) {
+            stage = "encode";
+            error = ENOMEM;
+            break;
+        }
+        size = strlen(json);
+        if (size >= RADISH_JSONL_LINE_LIMIT) {
+            stage = "line_limit";
+            error = EOVERFLOW;
+            result = FLB_ERROR;
+        }
+        else if (radish_jsonl_write(fd, json, size) != 0 ||
+                 radish_jsonl_write(fd, "\n", 1) != 0) {
+            stage = "write";
+            error = errno;
+        }
+        flb_free(json);
+        if (error != 0) {
+            break;
+        }
+    }
+    if (error == 0 &&
+        flb_log_event_decoder_get_last_result(&decoder) != FLB_EVENT_DECODER_SUCCESS) {
+        error = EINVAL;
+        result = FLB_ERROR;
+    }
+    flb_log_event_decoder_destroy(&decoder);
+
+finish:
+    outcome = radish_jsonl_finish(fd, file.st_size, error != 0);
+    if (outcome == RADISH_JSONL_UNKNOWN) {
+        result = block_radish_file(ctx, &file, FLB_TRUE);
+    }
+    else if (outcome == RADISH_JSONL_COMPLETE) {
+        result = FLB_OK;
+    }
+    else {
+        flb_plg_error(ctx->ins, "JSONL batch rolled back (stage=%s errno=%d)",
+                      stage, error);
+    }
+    file_rotate_update(rotation, NULL);
+
+release:
+    file_rotate_release(rotation);
+    return result;
+}
+#endif
