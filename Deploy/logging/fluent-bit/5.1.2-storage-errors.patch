diff --git a/plugins/out_file/radish_jsonl.c b/plugins/out_file/radish_jsonl.c
new file mode 100644
index 0000000..41ace37
--- /dev/null
+++ b/plugins/out_file/radish_jsonl.c
@@ -0,0 +1,151 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#ifndef _WIN32
+
+#include "radish_jsonl.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <unistd.h>
+
+int radish_jsonl_open(const char *path, struct stat *file)
+{
+    int fd;
+    int error;
+
+    fd = open(path, O_RDWR | O_APPEND | O_CREAT | O_CLOEXEC | O_NOFOLLOW |
+             O_NONBLOCK, 0666);
+    if (fd < 0) {
+        return -1;
+    }
+    if (fstat(fd, file) == 0) {
+        if (S_ISREG(file->st_mode)) {
+            return fd;
+        }
+        errno = EINVAL;
+    }
+    error = errno;
+    close(fd);
+    errno = error;
+    return -1;
+}
+
+static int truncate_and_check(int fd, off_t size, struct stat *file)
+{
+    if (ftruncate(fd, size) != 0 || fstat(fd, file) != 0) {
+        return -1;
+    }
+    if (file->st_size != size) {
+        errno = EIO;
+        return -1;
+    }
+
+    return 0;
+}
+
+int radish_jsonl_repair_tail(int fd, struct stat *file)
+{
+    char tail[RADISH_JSONL_LINE_LIMIT];
+    off_t start;
+    size_t have = 0;
+    size_t length;
+    ssize_t count;
+
+    if (file->st_size == 0) {
+        return 0;
+    }
+
+    do {
+        count = pread(fd, tail, 1, file->st_size - 1);
+    } while (count < 0 && errno == EINTR);
+    if (count != 1) {
+        if (count == 0) {
+            errno = EIO;
+        }
+        return -1;
+    }
+    if (tail[0] == '\n') {
+        return 0;
+    }
+
+    length = file->st_size < (off_t) sizeof(tail) ?
+        (size_t) file->st_size : sizeof(tail);
+    start = file->st_size - (off_t) length;
+    while (have < length) {
+        count = pread(fd, tail + have, length - have, start + (off_t) have);
+        if (count < 0 && errno == EINTR) {
+            continue;
+        }
+        if (count <= 0) {
+            if (count == 0) {
+                errno = EIO;
+            }
+            return -1;
+        }
+        have += (size_t) count;
+    }
+
+    while (have > 0 && tail[have - 1] != '\n') {
+        have--;
+    }
+    if (have == 0 && start != 0) {
+        errno = EINVAL;
+        return -1;
+    }
+
+    return truncate_and_check(fd, start + (off_t) have, file);
+}
+
+int radish_jsonl_write(int fd, const char *data, size_t size)
+{
+    ssize_t count;
+
+    while (size > 0) {
+        count = write(fd, data, size);
+        if (count < 0 && errno == EINTR) {
+            continue;
+        }
+        if (count <= 0) {
+            if (count == 0) {
+                errno = EIO;
+            }
+            return -1;
+        }
+        data += count;
+        size -= (size_t) count;
+    }
+
+    return 0;
+}
+
+enum radish_jsonl_result radish_jsonl_finish(int fd, off_t offset, int rollback)
+{
+    struct stat file;
+    enum radish_jsonl_result result = RADISH_JSONL_COMPLETE;
+    int error = 0;
+
+    if (rollback) {
+        if (fstat(fd, &file) != 0) {
+            error = errno;
+        }
+        else if (file.st_size < offset) {
+            error = EIO;
+        }
+        else if (file.st_size > offset && truncate_and_check(fd, offset, &file) != 0) {
+            error = errno;
+        }
+        result = RADISH_JSONL_ROLLED_BACK;
+    }
+
+    /* Raw writes have no pending stdio buffer that could be flushed after rollback. */
+    if (close(fd) != 0 && error == 0) {
+        error = errno;
+    }
+    if (error != 0) {
+        errno = error;
+        return RADISH_JSONL_UNKNOWN;
+    }
+
+    return result;
+}
+
+#endif
